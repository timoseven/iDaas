# iDaas 运行配置样例
# 复制为 .env 后按需修改。启动时通过 -env 指定加载：
#   ./idaas -env .env
# 也可继续用进程环境变量：set -a; . ./.env; set +a  或 systemd EnvironmentFile=.env
# 已存在的进程环境变量优先，不会被本文件覆盖。

# 监听地址与数据库（bbolt 单文件 .db 二进制存储）
LISTEN_ADDR=:8088
DB_PATH=idaas.db

# 会话相关密钥（生产环境必须改为强随机值，例如：openssl rand -hex 32）
SECRET_KEY=change-me-to-a-strong-random-secret

# --- SAML 2.0 IdP（多云通用，各云规格内置） ---
# EntityID，建议即对外可访问的 metadata URL
SAML_ENTITY_ID=http://localhost:8088/saml/metadata
# 站点对外 base URL（用于 metadata 中的 SSO endpoint Location）
SAML_BASE_URL=http://localhost:8088
# IdP 证书与私钥路径
SAML_CERT_PATH=certs/idp.crt
SAML_KEY_PATH=certs/idp.key
# Assertion 有效期（分钟）
SAML_ASSERTION_VALID_MINUTES=5
# metadata 中的组织信息（可选）
SAML_ORG_NAME=iDaas
SAML_ORG_DISPLAY_NAME=iDaas Identity Provider
SAML_ORG_URL=
SAML_CONTACT_EMAIL=

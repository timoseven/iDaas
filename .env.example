# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-string

# Database
DATABASE_URL=sqlite:///idaas.db

# ----- SAML 2.0 IdP -----
# IdP EntityID（建议即 metadata URL）
SAML_ENTITY_ID=http://localhost:8088/saml/metadata
# 站点对外可访问的 base URL（用于 metadata 中的 SingleSignOnService Location）
SAML_BASE_URL=http://localhost:8088
# 阿里云固定 ACS 地址，通常无需修改
SAML_ACS_URL=https://signin.aliyun.com/saml/SSO
# 管理员手动提供的 X.509 证书与私钥路径（PEM 格式）
# 可用 openssl 生成：
#   openssl req -x509 -newkey rsa:2048 -keyout certs/idp.key -out certs/idp.crt -days 3650 -nodes -subj "/CN=iDaas IdP"
SAML_CERT_PATH=certs/idp.crt
SAML_KEY_PATH=certs/idp.key
# 阿里云侧创建 SAML IdP 后填入（格式：acs:ram::<主账号ID>:saml-provider/<IdP名>）
SAML_IDP_ARN=
# Assertion 有效期（分钟）
SAML_ASSERTION_VALID_MINUTES=5
# metadata 中的组织信息
SAML_ORG_NAME=iDaas
SAML_ORG_DISPLAY_NAME=iDaas Identity Provider
SAML_ORG_URL=
SAML_CONTACT_EMAIL=
